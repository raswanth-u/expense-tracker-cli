#![allow(dead_code)]

use anyhow::{Context, Result};
use serde::Deserialize;
use std::fs;

use crate::cli::Environment;

#[derive(Debug, Deserialize, Clone)]
pub struct Config {
    pub api: ApiConfig,
    pub display: DisplayConfig,
    pub defaults: DefaultsConfig,
    #[serde(skip)]
    pub environment: Option<Environment>,
}

#[derive(Debug, Deserialize, Clone)]
pub struct ApiConfig {
    pub base_url: String,
    pub api_key: String,
    pub skip_ssl_verify: bool,
}

#[derive(Debug, Deserialize, Clone)]
pub struct DisplayConfig {
    pub python_path: String,
    pub display_module: String,
}

#[derive(Debug, Deserialize, Clone)]
pub struct DefaultsConfig {
    pub default_user_id: usize,
    pub date_format: String,
}

impl Config {
    /// Load configuration based on environment
    /// 
    /// Searches for config files in this order:
    /// 1. config/config_<env>.toml (environment-specific)
    /// 2. config/config.toml (fallback/default)
    pub fn load_for_env(env: Environment) -> Result<Self> {
        let env_name = match env {
            Environment::Dev => "dev",
            Environment::Prod => "prod",
        };
        
        // Try environment-specific config first
        let env_config_path = format!("config/config_{}.toml", env_name);
        let default_config_path = "config/config.toml";
        
        let config_path = if std::path::Path::new(&env_config_path).exists() {
            eprintln!("🔧 Using {} environment config", env_name.to_uppercase());
            env_config_path
        } else if std::path::Path::new(default_config_path).exists() {
            eprintln!("⚠️  No config_{}.toml found, using default config.toml", env_name);
            default_config_path.to_string()
        } else {
            eprintln!("❌ Configuration file not found!");
            eprintln!("📝 Please create config files:");
            eprintln!("\nFor development:");
            eprintln!("  cp config/config.toml.example config/config_dev.toml");
            eprintln!("  # Edit with dev settings (port 8443)");
            eprintln!("\nFor production:");
            eprintln!("  cp config/config.toml.example config/config_prod.toml");
            eprintln!("  # Edit with prod settings (port 443)");
            std::process::exit(1);
        };
        
        let content = fs::read_to_string(&config_path)
            .context(format!("Failed to read config file: {}", config_path))?;
        
        let mut config: Config = toml::from_str(&content)
            .context("Failed to parse config file")?;
        
        config.environment = Some(env);
        Ok(config)
    }
    
    /// Load configuration from default file (for backward compatibility)
    pub fn load() -> Result<Self> {
        Self::load_for_env(Environment::Dev)
    }
    
    /// Get current environment name
    pub fn env_name(&self) -> &str {
        match self.environment {
            Some(Environment::Dev) => "development",
            Some(Environment::Prod) => "production",
            None => "unknown",
        }
    }
    
    /// Get Python interpreter path (use system default if not specified)
    pub fn python_interpreter(&self) -> String {
        if self.display.python_path.is_empty() {
            "python3".to_string()
        } else {
            self.display.python_path.clone()
        }
    }
}
