# =============================================================================
# EXPENSE TRACKER CLI - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
#
# Copy this file to .env.dev or .env.prod and fill in actual values.
# 
# DO NOT commit .env files to Git - they contain secrets!
# Add to .gitignore:
#   .env
#   .env.local
#   .env.dev
#   .env.prod
#
# Usage:
#   source .env.dev && expense --env dev user list
#   source .env.prod && expense --env prod user list
#
# =============================================================================

# =============================================================================
# DEVELOPMENT ENVIRONMENT SECRETS
# =============================================================================

# API Key for development environment
# Get this from: https://localhost:8443/api/docs (dev environment)
API_KEY_DEV=your-dev-api-key-here-change-me

# Skip SSL verification for development (usually true due to self-signed certs)
# In production, ALWAYS set to false!
SKIP_SSL_VERIFY_DEV=true

# =============================================================================
# PRODUCTION ENVIRONMENT SECRETS
# =============================================================================

# API Key for production environment
# Get this from: https://localhost/api/docs (prod environment)
# ⚠️ IMPORTANT: Use a different key than development!
API_KEY_PROD=your-prod-api-key-here-change-me

# Skip SSL verification for production (should be false with valid certs)
# Set to true only if using self-signed certificates (NOT RECOMMENDED for prod)
SKIP_SSL_VERIFY_PROD=false

# =============================================================================
# OPTIONAL: DATABASE ACCESS (if using CLI for direct DB operations)
# =============================================================================

# Development database
DB_HOST_DEV=localhost
DB_PORT_DEV=5433
DB_USER_DEV=expense_admin
DB_PASSWORD_DEV=dev_password_change_me
DB_NAME_DEV=expenses_db

# Production database
DB_HOST_PROD=localhost
DB_PORT_PROD=5432
DB_USER_PROD=expense_admin
DB_PASSWORD_PROD=prod_password_change_me
DB_NAME_PROD=expenses_db

# =============================================================================
# Notes:
# =============================================================================
#
# 1. API Keys:
#    - Different keys for dev and prod (security best practice)
#    - Rotate regularly in production
#    - Never share via messaging apps or email
#
# 2. SSL Verification:
#    - Development: Usually true (self-signed certs)
#    - Production: Should be false (valid certificates from CA)
#
# 3. Database Credentials:
#    - Only needed if CLI needs direct DB access
#    - Usually container-internal only
#    - Keep passwords strong: $(openssl rand -base64 32)
#
# 4. File Permissions:
#    - chmod 600 .env.dev .env.prod (read/write by owner only)
#    - Prevents accidental exposure
#
# 5. Rotation:
#    - Rotate keys every 90 days
#    - Rotate on team member departure
#    - Immediately rotate if compromised
#
